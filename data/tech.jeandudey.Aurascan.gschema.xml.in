<?xml version="1.0" encoding="UTF-8" ?>
<schemalist>
  <enum id="tech.jeandudey.Aurascan.Backend">
    <value nick="flex" value="0"/>
    <value nick="vulkan" value="1"/>
    <value nick="rocm" value="2"/>
  </enum>
  <enum id="tech.jeandudey.Aurascan.Output">
    <value nick="wine" value="0"/>
    <value nick="flightgear" value="1"/>
    <value nick="network" value="2"/>
  </enum>
  <schema id="@APP_ID@" path="/tech/jeandudey/Aurascan/">
    <key name="window-width" type="i">
      <default>800</default>
      <summary>Default window width</summary>
      <description>Default window width</description>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Default window height</summary>
      <description>Default window height</description>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Default window maximized behavior</summary>
      <description>Default window maximized behavior</description>
    </key>
    <key name="backend" enum="tech.jeandudey.Aurascan.Backend">
      <default>"flex"</default>
      <summary>Inference backend</summary>
      <description>Backend used for inference</description>
    </key>
    <key name="output" enum="tech.jeandudey.Aurascan.Output">
      <default>"wine"</default>
      <summary>Head pose output</summary>
      <description>Where to send head pose information</description>
    </key>
    <key name="use-steam-proton" type="b">
      <default>true</default>
      <summary>Use Steam Proton when the Wine output is selected</summary>
      <description>Send head pose information to Steam Proton applications</description>
    </key>
    <key name="steam-application-id" type="s">
      <default>""</default>
      <summary>The ID of the Steam application to send head pose information</summary>
      <description>The ID of the Steam application to send head pose information</description>
    </key>
    <key name="last-camera-id" type="s">
      <default>""</default>
      <summary>Last Camera Used ID</summary>
      <description>An ID representing the last used camera</description>
    </key>
  </schema>
</schemalist>
