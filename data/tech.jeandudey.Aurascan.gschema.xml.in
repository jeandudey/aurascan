<?xml version="1.0" encoding="UTF-8" ?>
<schemalist>
  <schema id="@BASE_ID@" path="/tech/jeandudey/Aurascan">
    <key name="window-width" type="i">
      <default>1280</default>
    </key>

    <key name="window-height" type="i">
      <default>720</default>
    </key>

    <key name="backend" type="s">
      <choices>
        <choice value="ROCm" />
        <choice value="Vulkan" />
        <choice value="Flex" />
      </choices>
      <default>ROCm</default>
      <summary>Backend to use for inference</summary>
    </key>
  </schema>
</schemalist>
