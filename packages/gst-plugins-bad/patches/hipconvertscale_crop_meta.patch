+static GstFlowReturn
+gst_hip_base_convert_generate_output (GstBaseTransform * trans,
+    GstBuffer ** buffer)
+{
+  auto self = GST_HIP_BASE_CONVERT (trans);
+  auto priv = self->priv;
+
+  if (!trans->queued_buf)
+    return GST_FLOW_OK;
+
+  if (!priv->same_caps || gst_buffer_get_video_crop_meta (trans->queued_buf)) {
+    return GST_BASE_TRANSFORM_CLASS (parent_class)->generate_output (trans,
+        buffer);
+  }
+
+  *buffer = trans->queued_buf;
+  trans->queued_buf = nullptr;
+
+  return GST_FLOW_OK;
+}
