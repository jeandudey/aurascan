load("//autotools:defs.bzl", "autotools_project")
load("//rules/pkg_config:defs.bzl", "pkg_config_pc")

http_archive(
    name = "pcre2-source",
    urls = ["https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.47/pcre2-10.47.tar.bz2"],
    sha256 = "47fe8c99461250d42f89e6e8fdaeba9da057855d06eb7fc08d9ca03fd08d7bc7",
    strip_prefix = "pcre2-10.47",
)

autotools_project(
    name = "pcre2",
    source = ":pcre2-source",
    sub_targets = [
        "include",
        "lib/libpcre2-8.a",
        "lib/libpcre2-8.so",
        "lib/libpcre2-posix.a",
        "lib/libpcre2-posix.so",
    ],
    visibility = ["PUBLIC"],
)

prebuilt_cxx_library(
    name = "libpcre2",
    static_lib = ":pcre2[lib/libpcre2-8.a]",
    shared_lib = ":pcre2[lib/libpcre2-8.so]",
    header_dirs = [":pcre2[include]"],
)

pkg_config_pc(
    name = "libpcre2.pc",
    library = ":libpcre2",
)

prebuilt_cxx_library(
    name = "libpcre2-posix",
    static_lib = ":pcre2[lib/libpcre2-posix.a]",
    shared_lib = ":pcre2[lib/libpcre2-posix.so]",
    header_dirs = [":pcre2[include]"],
    deps = [":libpcre2"],
)
