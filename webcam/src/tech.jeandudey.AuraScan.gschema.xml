<?xml version="1.0" encoding="UTF-8" ?>
<schemalist>
    <schema id="tech.jeandudey.AuraScan" path="/tech/jeandudey/AuraScan">
        <key name="window-width" type="i">
            <default>1280</default>
        </key>

        <key name="window-height" type="i">
            <default>720</default>
        </key>

        <key name="backend" type="s">
            <choices>
                <choice value="ROCm" />
                <choice value="Vulkan" />
                <choice value="Flex" />
            </choices>
            <default>ROCm</default>
        </key>
    </schema>
</schemalist>
