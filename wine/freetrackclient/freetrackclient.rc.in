#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FreeTrack"
            VALUE "FileDescription",  "FreeTrackClient"
            VALUE "FileVersion",      "@dllversion@"
            VALUE "InternalName",     "FreeTrackClient"
            VALUE "OriginalFilename", "FreeTrackClient.dll"
            VALUE "ProductName",      "FreeTrackClient"
            VALUE "ProductVersion",   "@dllversion@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
